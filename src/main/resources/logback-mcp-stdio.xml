<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging config for the mcp-stdio profile. The console appender targets
  System.err so that stdout stays clean for the MCP JSON-RPC stream — any log
  line on stdout would corrupt the protocol.
-->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDERR"/>
    </root>
</configuration>
